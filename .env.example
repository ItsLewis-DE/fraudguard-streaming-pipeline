# ==========================================
# FraudGuard Local Environment Configuration
# Copy this file to .env and change secrets before running.
# ==========================================

# 1. AIRFLOW CONFIGURATION
AIRFLOW_IMAGE_NAME=fraudguard-airflow:3.2.2
AIRFLOW_UID=1000
AIRFLOW_PORT=8084
AIRFLOW_PARALLELISM=2
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=2
COMPOSE_IGNORE_ORPHANS=true

AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_FERNET_KEY=hgPKSTYIPpMXRW2s03MChhIa0FHLryflFNzG4FO1164=
AIRFLOW_API_JWT_SECRET=fraudguard-local-jwt-secret-change-me

# 2. MINIO (S3) STORAGE
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret
MINIO_AIRFLOW_USER=fraudguard
MINIO_AIRFLOW_PASSWORD=fraudguard-secret

# 3. CLICKHOUSE CONFIGURATION & ROLE PASSWORDS
CLICKHOUSE_DB=fraudguard
CLICKHOUSE_USER=fraudguard
CLICKHOUSE_PASSWORD=fraudguard-secret

CLICKHOUSE_LOADER_USER=fraudguard_loader
CLICKHOUSE_LOADER_PASSWORD=replace-with-loader-password
CLICKHOUSE_SUPERSET_PASSWORD=replace-with-superset-password
DBT_CLICKHOUSE_PASSWORD=replace-with-transformer-password
CLICKHOUSE_ML_PASSWORD=replace-with-ml-reader-password

# 4. LOCAL CLI CONFIGURATION (For running dbt or ML scripts on host)
DBT_CLICKHOUSE_HOST=localhost
DBT_CLICKHOUSE_PORT=8123
DBT_CLICKHOUSE_DATABASE=fraudguard
DBT_CLICKHOUSE_USER=fraudguard_transformer
DBT_CLICKHOUSE_THREADS=4

CLICKHOUSE_ML_HOST=localhost
CLICKHOUSE_ML_PORT=8123
CLICKHOUSE_ML_DATABASE=fraudguard
CLICKHOUSE_ML_USER=fraudguard_ml_reader
CLICKHOUSE_ML_SECURE=false
